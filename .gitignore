.env
*.mov
*.mp4
*.env.local
.DS_Store
node_modules/
__pycache__/
*.pyc
.idea/

# Personal/local Claude Code permission overrides — accumulates individual
# approvals, not shared project config. .claude/settings.json (the real,
# deliberate config) is not excluded.
.claude/settings.local.json

# Internal-only, never for client handover — session-continuity notes,
# internal design/recording docs, and engagement/client details. These
# reference real employer/personal-project/client names and must never
# leave this machine.
PROGRESS.md
docs/internal/
ENGAGEMENT.md
PROGRESS_ci_cd_demo.md

# PIPELINE_WALKTHROUGH.md is deliberately NOT excluded — its content is
# a client-safe architecture writeup (agent roles, pipeline design,
# file-by-file breakdown), reviewed and confirmed to contain no names
# or engagement-specific details. It's the one internal-design doc
# that ships with the repo instead of staying local-only.

# Terraform local state and working dirs — never commit real cluster state.
# The wildcard-suffix form (not just an exact .tfstate.backup match) also
# catches Terraform's timestamped backup variant, e.g.
# terraform.tfstate.1783693614.backup, which the exact-suffix pattern missed.
terraform/**/.terraform/
terraform/**/*.tfstate*
terraform/**/tfplan*

# Real Terraform variable values (credentials, tokens) — never commit an
# actual .tfvars file. *.tfvars.example files are explicitly allowed back
# in below since they document expected format with no real values.
terraform/**/*.tfvars
!terraform/**/*.tfvars.example
