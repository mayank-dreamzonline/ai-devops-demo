{
  "permissions": {
    "allow": [
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl get events*)",
      "Bash(kubectl port-forward *)",
      "Bash(terraform init*)",
      "Bash(terraform validate*)",
      "Bash(terraform plan*)",
      "Bash(terraform show *)",
      "Bash(terraform -chdir=* init*)",
      "Bash(terraform -chdir=* validate*)",
      "Bash(terraform -chdir=* plan*)",
      "Bash(terraform -chdir=* show *)",
      "Bash(terraform output*)",
      "Bash(terraform -chdir=* output*)",
      "Bash(mv agents/*/tasks/*/*)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(aws eks update-kubeconfig*)"
    ],
    "deny": [
      "Bash(terraform destroy*)",
      "Bash(terraform -chdir=* destroy*)",
      "Bash(kubectl delete namespace *)",
      "Bash(kubectl delete node *)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(terraform apply *)",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/terraform-checker.sh"
          },
          {
            "type": "command",
            "if": "Bash(terraform -chdir=* apply *)",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/terraform-checker.sh"
          }
        ]
      }
    ]
  }
}
